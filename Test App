"""
Minimal test app to debug the P&L Command Center
Run this to verify all dependencies are installed and working
"""

import streamlit as st
import sys
import os

st.set_page_config(page_title="P&L Test", layout="wide")

# ============================================================================
# TEST 1: Dependencies
# ============================================================================
st.header("🔍 P&L Command Center — Diagnostics")

st.subheader("1️⃣ Checking Dependencies")
dependencies = {
    "streamlit": "streamlit",
    "pandas": "pandas",
    "numpy": "numpy",
    "plotly": "plotly",
    "openpyxl": "openpyxl",
}

deps_ok = True
for name, module in dependencies.items():
    try:
        __import__(module)
        st.success(f"✅ {name} — installed")
    except ImportError:
        st.error(f"❌ {name} — NOT installed. Run: pip install {name}")
        deps_ok = False

if not deps_ok:
    st.stop()

# ============================================================================
# TEST 2: File System
# ============================================================================
st.subheader("2️⃣ Checking File System")

from pathlib import Path

data_dir = Path("data")
if data_dir.exists():
    st.success(f"✅ data/ folder exists")
    files = list(data_dir.glob("*"))
    st.write(f"   Files: {len(files)}")
    for f in files:
        st.write(f"   - {f.name}")
else:
    st.warning(f"⚠️  data/ folder does NOT exist. Creating...")
    data_dir.mkdir(exist_ok=True)
    st.success(f"✅ Created data/ folder")

# ============================================================================
# TEST 3: Data Loader
# ============================================================================
st.subheader("3️⃣ Testing Data Loader")

try:
    from data_loader import load_all_data, get_summary, get_expense_summary
    st.success("✅ data_loader.py imports successfully")
    
    # Try to load data
    raw = load_all_data()
    if raw is not None and len(raw) > 0:
        st.success(f"✅ Data loaded: {len(raw)} rows")
        st.write(f"   Columns: {raw.columns.tolist()}")
        st.write(f"   Periods: {raw['Period'].nunique() if 'Period' in raw.columns else 'N/A'}")
        st.write(f"   Wells: {raw['Well'].nunique() if 'Well' in raw.columns else 'N/A'}")
        
        # Try to build summaries
        summary = get_summary(raw)
        exp_summary = get_expense_summary(raw)
        st.success(f"✅ Revenue summary: {len(summary)} rows")
        st.success(f"✅ Expense summary: {len(exp_summary)} rows")
    else:
        st.info("ℹ️  No data loaded yet. Upload a GL export below to test.")
        
except Exception as e:
    st.error(f"❌ Data loader error: {e}")
    import traceback
    st.code(traceback.format_exc())

# ============================================================================
# TEST 4: File Upload
# ============================================================================
st.subheader("4️⃣ Test File Upload")

uploaded_file = st.file_uploader("Upload a GL export (Excel or CSV)", type=["xlsx", "xls", "csv"])

if uploaded_file is not None:
    st.write(f"File: {uploaded_file.name}")
    st.write(f"Size: {uploaded_file.size / 1024:.1f} KB")
    
    try:
        from data_loader import ingest_file
        result = ingest_file(uploaded_file)
        
        if result.get("status") == "ok":
            st.success(f"✅ File ingested successfully!")
            st.write(f"   Rows: {result.get('rows', 0):,}")
            st.write(f"   Periods: {result.get('months', 0)}")
            st.write(f"   Wells: {result.get('wells', 0)}")
            
            # Show loaded data
            raw = load_all_data()
            if raw is not None:
                st.success(f"✅ Total data now: {len(raw):,} rows")
                
                # Show sample
                st.write("Sample of loaded data:")
                st.dataframe(raw.head(10), use_container_width=True)
        elif result.get("status") == "duplicate":
            st.info("ℹ️  File already loaded (duplicate)")
        else:
            st.error(f"❌ Error: {result.get('message', 'Unknown error')}")
            
    except Exception as e:
        st.error(f"❌ Upload error: {e}")
        import traceback
        st.code(traceback.format_exc())

# ============================================================================
# TEST 5: Status
# ============================================================================
st.subheader("5️⃣ Overall Status")

try:
    from data_loader import load_all_data
    raw = load_all_data()
    
    if raw is not None and len(raw) > 0:
        st.success("""
        ✅ **ALL SYSTEMS GO!**
        
        Your P&L Command Center is ready to use.
        
        Run: `streamlit run app.py`
        """)
    else:
        st.info("""
        ⚠️  **READY, but NO DATA**
        
        Upload a GL export file above to test the system.
        Once you upload, run: `streamlit run app.py`
        """)
except Exception as e:
    st.error(f"❌ System error: {e}")
